# Local: cp .env.example .env; load these vars with your shell or a dotenv utility.
APP_ENV=development
DATA_BACKEND=sqlite
SQLITE_PATH=./data/carecircle.sqlite3
APP_SECRET=replace-with-a-strong-random-secret-32-chars
DEMO_MODE=1
# Real email (optional). Without one of these, alerts are stored as demo notifications.
# SENDGRID_API_KEY=
# MAIL_FROM_EMAIL=verified@yourdomain.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=CareCircle <verified@yourdomain.com>
# SCHEDULER_SECRET=another-long-random-secret
